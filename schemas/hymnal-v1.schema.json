{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PopGTN/bible-data/main/schemas/hymnal-v1.schema.json",
  "title": "Basic Bible hymn book, version 1",
  "description": "One hymn book for the Basic Bible app. See docs/repositories.md. The app also accepts the legacy format: a bare array of hymn objects.",
  "type": "object",
  "required": ["format", "book", "hymns"],
  "properties": {
    "format": { "const": "hymnal" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "book": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "shortTitle": { "type": "string" },
        "publisher": { "type": "string" },
        "publisherAddress": { "type": "string" },
        "publisherUrl": { "type": "string" },
        "edition": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "language": { "type": "string" },
        "isbn": { "type": ["string", "null"] },
        "copyright": { "type": "string" },
        "permissionNotice": { "type": "string" },
        "rightsStatus": {
          "enum": ["public_domain", "open_license", "permission_granted", "unclear", "copyrighted_no_distribution"]
        },
        "sourceUrl": { "type": ["string", "null"] },
        "takedownContact": { "type": ["string", "null"] }
      }
    },
    "hymns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/hymn" }
    }
  },
  "$defs": {
    "lines": { "type": "array", "items": { "type": "string" } },
    "part": {
      "type": "object",
      "required": ["lines"],
      "properties": {
        "label": { "type": "string" },
        "lines": { "$ref": "#/$defs/lines" }
      }
    },
    "hymn": {
      "type": "object",
      "required": ["id"],
      "anyOf": [{ "required": ["verses"] }, { "required": ["chorus"] }],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "meter": { "type": "string" },
        "tuneName": { "type": "string" },
        "verses": { "type": "array", "items": { "$ref": "#/$defs/lines" } },
        "chorus": { "$ref": "#/$defs/lines" },
        "addedChorus": { "$ref": "#/$defs/lines" },
        "alternateChoruses": { "type": "array", "items": { "$ref": "#/$defs/part" } },
        "optionalVerses": { "type": "array", "items": { "$ref": "#/$defs/part" } },
        "notes": { "$ref": "#/$defs/lines" },
        "copyright": { "type": "string" },
        "rightsStatus": { "type": "string" }
      }
    }
  }
}
